<?xml version="1.0" encoding="utf-8"?>
<!-- Steps: a shape filling towards your goal; bigger sizes add details and the week. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/w_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/w_card"
        android:tint="@color/card_icons"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/s_stage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center">

        <FrameLayout
            android:id="@+id/s_track"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="top|left"
            android:visibility="visible">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:src="@drawable/shp_cookie9"
                android:tint="@color/primary_container" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/s_liquid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="top|left"
            android:visibility="visible">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:src="@drawable/lq_cookie9_060"
                android:tint="@color/primary_accent" />
        </FrameLayout>

        <TextView
            android:id="@+id/s_num"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top|left"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="6,240"
            android:textColor="@color/primary_on_accent"
            android:textSize="26sp"
            android:visibility="visible" />

        <TextView
            android:id="@+id/s_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top|left"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="of 8k"
            android:textColor="@color/primary_on_accent"
            android:textSize="12sp"
            android:visibility="visible" />

        <FrameLayout
            android:id="@+id/s_badge"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_gravity="top|left"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/s_badge_icon"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_gravity="top|left"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_check"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/s_info"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_gravity="top|left"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/s_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"
                android:textColor="@color/w_text"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/s_c0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:background="@drawable/w_pill"
                android:backgroundTint="@color/primary_container"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:singleLine="true"
                android:textColor="@color/primary_on_container"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/s_c1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:background="@drawable/w_pill"
                android:backgroundTint="@color/secondary_container"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:singleLine="true"
                android:textColor="@color/secondary_on_container"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/s_c2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:background="@drawable/w_pill"
                android:backgroundTint="@color/tertiary_container"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:singleLine="true"
                android:textColor="@color/tertiary_on_container"
                android:textSize="12sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/s_week"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_gravity="top|left"
            android:orientation="horizontal"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="bottom|center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/s_bar0"
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:layout_marginHorizontal="3dp"
                    android:scaleType="fitXY"
                    android:src="@drawable/w_pill"
                    android:tint="@color/primary_container" />

                <TextView
                    android:id="@+id/s_day0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/w_text2"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="bottom|center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/s_bar1"
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:layout_marginHorizontal="3dp"
                    android:scaleType="fitXY"
                    android:src="@drawable/w_pill"
                    android:tint="@color/primary_container" />

                <TextView
                    android:id="@+id/s_day1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/w_text2"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="bottom|center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/s_bar2"
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:layout_marginHorizontal="3dp"
                    android:scaleType="fitXY"
                    android:src="@drawable/w_pill"
                    android:tint="@color/primary_container" />

                <TextView
                    android:id="@+id/s_day2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/w_text2"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="bottom|center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/s_bar3"
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:layout_marginHorizontal="3dp"
                    android:scaleType="fitXY"
                    android:src="@drawable/w_pill"
                    android:tint="@color/primary_container" />

                <TextView
                    android:id="@+id/s_day3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/w_text2"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="bottom|center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/s_bar4"
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:layout_marginHorizontal="3dp"
                    android:scaleType="fitXY"
                    android:src="@drawable/w_pill"
                    android:tint="@color/primary_container" />

                <TextView
                    android:id="@+id/s_day4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/w_text2"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="bottom|center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/s_bar5"
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:layout_marginHorizontal="3dp"
                    android:scaleType="fitXY"
                    android:src="@drawable/w_pill"
                    android:tint="@color/primary_container" />

                <TextView
                    android:id="@+id/s_day5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/w_text2"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="bottom|center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/s_bar6"
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:layout_marginHorizontal="3dp"
                    android:scaleType="fitXY"
                    android:src="@drawable/w_pill"
                    android:tint="@color/primary_container" />

                <TextView
                    android:id="@+id/s_day6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/w_text2"
                    android:textSize="10sp" />
            </LinearLayout>

        </LinearLayout>
    </FrameLayout>
</FrameLayout>
