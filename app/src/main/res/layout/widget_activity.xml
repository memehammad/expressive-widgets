<?xml version="1.0" encoding="utf-8"?>
<!-- Latest workout from Health Connect (Strava, Fit, ...). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/w_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/w_card"
        android:tint="@color/card_icons"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/x_stage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center">

        <FrameLayout
            android:id="@+id/x_blob"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="top|left"
            android:visibility="visible">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:src="@drawable/shp_arrow"
                android:tint="@color/tertiary_container" />
        </FrameLayout>

        <ImageView
            android:id="@+id/x_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="top|left"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="24dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_run"
            android:tint="@color/tertiary_on_container" />

        <TextView
            android:id="@+id/x_num"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top|left"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="5.2"
            android:textColor="@color/tertiary_on_container"
            android:textSize="18sp"
            android:visibility="visible" />

        <LinearLayout
            android:id="@+id/x_info"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_gravity="top|left"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/x_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"
                android:textColor="@color/w_text"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/x_c0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:background="@drawable/w_pill"
                android:backgroundTint="@color/tertiary_container"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:singleLine="true"
                android:textColor="@color/tertiary_on_container"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/x_c1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:background="@drawable/w_pill"
                android:backgroundTint="@color/primary_container"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:singleLine="true"
                android:textColor="@color/primary_on_container"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/x_c2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:background="@drawable/w_pill"
                android:backgroundTint="@color/secondary_container"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:singleLine="true"
                android:textColor="@color/secondary_on_container"
                android:textSize="12sp" />

        </LinearLayout>

    </FrameLayout>
</FrameLayout>
