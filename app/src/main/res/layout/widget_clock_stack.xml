<?xml version="1.0" encoding="utf-8"?>
<!-- Shape clock (hours over minutes). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToOutline="true"
    android:padding="6dp">

    <ImageView
        android:id="@+id/c_shape"
        android:src="@drawable/shp_cookie9"
        android:tint="@color/primary_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="22dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <TextClock
                android:id="@+id/c_hour"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:autoSizeMaxTextSize="96sp"
                android:autoSizeMinTextSize="12sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="sans-serif-black"
                android:format12Hour="hh"
                android:format24Hour="HH"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textColor="@color/primary_on_container"
                android:maxLines="1" />

            <TextClock
                android:id="@+id/c_min"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:autoSizeMaxTextSize="96sp"
                android:autoSizeMinTextSize="12sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="sans-serif-light"
                android:format12Hour="mm"
                android:format24Hour="mm"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textColor="@color/primary_on_container"
                android:maxLines="1" />

            <TextClock
                android:id="@+id/c_date"
                android:textColor="@color/primary_on_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:format12Hour="EEE d MMM"
                android:format24Hour="EEE d MMM"
                android:maxLines="1"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
