<?xml version="1.0" encoding="utf-8"?>
<!-- Clock canvas: shapes, texts and the date chip are sized and placed in code for each widget size. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToOutline="true">

    <!-- Card background (colour set in code, day and night separately). -->
    <ImageView
        android:id="@+id/w_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/w_card"
        android:tint="@color/card_icons"
        android:visibility="gone" />

<FrameLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/c_stage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center">

        <FrameLayout
            android:id="@+id/c_b0"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="top|left"
            android:padding="0dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:src="@drawable/shp_cookie9"
                android:tint="@color/primary_container" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/c_b1"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_gravity="top|left"
            android:visibility="gone" />

        <AnalogClock
            android:id="@+id/c_analog"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_gravity="top|left"
            android:dial="@drawable/shp_cookie12"
            android:hand_hour="@drawable/hand_hour"
            android:hand_minute="@drawable/hand_minute"
            android:hand_second="@drawable/hand_second"
            android:visibility="gone" />

        <TextClock
            android:id="@+id/c_t0"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="top|left"
            android:fontFamily="sans-serif-black"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/primary_on_container"
            android:textSize="30sp" />

        <TextClock
            android:id="@+id/c_t1"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_gravity="top|left"
            android:fontFamily="sans-serif-black"
            android:format12Hour="mm"
            android:format24Hour="mm"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/c_chip"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_gravity="top|left"
            android:visibility="gone">

            <ImageView
                android:id="@+id/c_chip_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/w_pill" />

            <TextClock
                android:id="@+id/c_date"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="sans-serif-medium"
                android:format12Hour="EEE d"
                android:format24Hour="EEE d"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1" />
        </FrameLayout>
    </FrameLayout>
</FrameLayout>
</FrameLayout>
