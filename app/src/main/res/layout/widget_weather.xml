<?xml version="1.0" encoding="utf-8"?>
<!-- Weather: icon and temperature in a shape matching the weather. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToOutline="true">

    <!-- Card background (colour set in code, day and night separately). -->
    <ImageView
        android:id="@+id/w_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/w_card"
        android:tint="@color/card_icons"
        android:visibility="gone" />

<FrameLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="4dp">
        <TextView
            android:id="@+id/wx_big"
            android:shadowColor="#59000000"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_gravity="top|left"
            android:fontFamily="sans-serif-black"
            android:gravity="bottom|left"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:visibility="gone" />

        <TextView
            android:id="@+id/wx_big_cond"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_gravity="top|left"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="top|left"
            android:singleLine="true"
            android:shadowColor="#59000000"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:textColor="@color/w_text"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/wx_frame"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="top|left">

            <FrameLayout
                android:id="@+id/wx_blob"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:src="@drawable/shp_sunny"
                    android:tint="@color/primary_container" />
            </FrameLayout>

            <ImageView
                android:id="@+id/wx_icon"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="top|left"
                android:layout_marginLeft="31dp"
                android:layout_marginTop="18dp"
                android:scaleType="fitCenter"
                android:src="@drawable/w_sun"
                android:tint="@color/primary_on_container" />

            <TextView
                android:id="@+id/wx_temp"
                android:layout_width="96dp"
                android:layout_height="32dp"
                android:layout_gravity="top|left"
                android:layout_marginTop="52dp"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="18°"
                android:textColor="@color/primary_on_container"
                android:textSize="22sp" />
        </FrameLayout>
</FrameLayout>
</FrameLayout>
