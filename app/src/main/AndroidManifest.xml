<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Weather (Open-Meteo) and, later, Home Assistant. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Optional: weather for where you are instead of a searched city. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- Agenda widget. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!-- Apps we open: Shizuku (setup). -->
    <queries>
        <package android:name="com.google.android.apps.weather" />
        <package android:name="com.samsung.android.weather" />
        <package android:name="com.sec.android.daemonapp" />
        <package android:name="com.miui.weather2" />
        <package android:name="net.oneplus.weather" />
        <package android:name="com.oplus.weather.service" />
        <package android:name="com.coloros.weather2" />
        <package android:name="com.motorola.timeweatherwidget" />
        <package android:name="com.huawei.android.totemweather" />
        <package android:name="org.breezyweather" />
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Widgets">

        <activity
            android:name=".OpenActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Widgets">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widgets.ClockProvider"
            android:exported="true"
            android:label="@string/w_clock">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/w_clock" />
        </receiver>

        <receiver
            android:name=".widgets.WorldClockProvider"
            android:exported="true"
            android:label="@string/w_world">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/w_world" />
        </receiver>

        <receiver
            android:name=".widgets.BatteryProvider"
            android:exported="true"
            android:label="@string/w_battery">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/w_battery" />
        </receiver>

        <receiver
            android:name=".widgets.TogglesProvider"
            android:exported="true"
            android:label="@string/w_toggles">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/w_toggles" />
        </receiver>

        <receiver
            android:name=".widgets.WeatherProvider"
            android:exported="true"
            android:label="@string/w_weather">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/w_weather" />
        </receiver>

        <receiver
            android:name=".widgets.AgendaProvider"
            android:exported="true"
            android:label="@string/w_agenda">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/w_agenda" />
        </receiver>

        <receiver
            android:name=".widgets.ToggleReceiver"
            android:exported="false" />

        <receiver
            android:name=".widgets.WeatherRefreshReceiver"
            android:exported="false" />

        <receiver
            android:name=".SystemReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
